{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "strategy": {
      "type": "string",
      "not": {
        "type": "null"
      }
    },
    "channel": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": [
            "null",
            "string"
          ]
        },
        "description": {
          "type": [
            "null",
            "string"
          ]
        },
        "language": {
          "type": [
            "null",
            "string"
          ]
        },
        "ttl": {
          "type": [
            "null",
            "integer"
          ],
          "exclusiveMinimum": 0
        },
        "time_zone": {
          "type": [
            "null",
            "string"
          ]
        },
        "author": {
          "type": [
            "null",
            "string"
          ]
        },
        "image": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "url"
      ]
    },
    "directory": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": [
            "null",
            "string"
          ],
          "maxLength": 160
        },
        "topics": {
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string",
            "enum": [
              "sports",
              "energy",
              "tech",
              "science",
              "news",
              "entertainment",
              "jobs",
              "finance",
              "security",
              "travel",
              "environment",
              "consumer",
              "civic",
              "product",
              "research"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "title"
      ]
    },
    "headers": {
      "type": "object",
      "description": "HTTP headers applied to every request.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "stylesheets": {
      "type": "array",
      "description": "Collection of stylesheets to attach to the RSS feed.",
      "items": {
        "$schema": "http://json-schema.org/draft-06/schema#",
        "type": "object",
        "properties": {
          "href": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "text/css",
              "text/xsl"
            ]
          },
          "media": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "href",
          "type"
        ]
      }
    },
    "auto_source": {
      "$schema": "http://json-schema.org/draft-06/schema#",
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "not": {
            "type": "null"
          },
          "exclusiveMinimum": 0
        },
        "scraper": {
          "type": "object",
          "properties": {
            "native_feed": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": []
            },
            "wordpress_api": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": []
            },
            "sitemap": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "not": {
                    "type": "null"
                  }
                },
                "min_priority": {
                  "type": "number",
                  "not": {
                    "type": "null"
                  }
                },
                "max_age_days": {
                  "type": "integer",
                  "not": {
                    "type": "null"
                  },
                  "exclusiveMinimum": 0
                }
              },
              "required": []
            },
            "schema": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": []
            },
            "microdata": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": []
            },
            "microformats2": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": []
            },
            "json_state": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": []
            },
            "xhr_articles": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": []
            },
            "meta_oembed": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": []
            },
            "semantic_html": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "not": {
                    "type": "null"
                  }
                },
                "fallback_anchorless": {
                  "type": "boolean",
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": []
            },
            "html": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "not": {
                    "type": "null"
                  }
                },
                "minimum_selector_frequency": {
                  "type": "integer",
                  "not": {
                    "type": "null"
                  },
                  "exclusiveMinimum": 0
                },
                "use_top_selectors": {
                  "type": "integer",
                  "not": {
                    "type": "null"
                  },
                  "exclusiveMinimum": 0
                },
                "fallback_anchorless": {
                  "type": "boolean",
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": []
            }
          },
          "required": []
        },
        "cleanup": {
          "type": "object",
          "properties": {
            "keep_different_domain": {
              "type": "boolean",
              "not": {
                "type": "null"
              }
            }
          },
          "required": []
        }
      },
      "required": [],
      "default": {
        "limit": 25,
        "scraper": {
          "native_feed": {
            "enabled": true
          },
          "wordpress_api": {
            "enabled": true
          },
          "sitemap": {
            "enabled": true,
            "min_priority": 0.3,
            "max_age_days": 30
          },
          "schema": {
            "enabled": true
          },
          "microdata": {
            "enabled": true
          },
          "microformats2": {
            "enabled": true
          },
          "json_state": {
            "enabled": true
          },
          "xhr_articles": {
            "enabled": true
          },
          "meta_oembed": {
            "enabled": true
          },
          "semantic_html": {
            "enabled": true,
            "fallback_anchorless": true
          },
          "html": {
            "enabled": true,
            "minimum_selector_frequency": 2,
            "use_top_selectors": 5,
            "fallback_anchorless": true
          }
        },
        "cleanup": {
          "keep_different_domain": false
        }
      }
    },
    "selectors": {
      "type": "object",
      "description": "Selectors used to extract article attributes.",
      "properties": {
        "items": {
          "$schema": "http://json-schema.org/draft-06/schema#",
          "type": "object",
          "properties": {
            "selector": {
              "type": "string",
              "minLength": 1
            },
            "order": {
              "enum": [
                "reverse"
              ],
              "not": {
                "type": "null"
              }
            },
            "enhance": {
              "type": "boolean",
              "not": {
                "type": "null"
              }
            },
            "pagination": {
              "description": "Pagination configuration or maximum page count integer.",
              "oneOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "object",
                  "properties": {
                    "strategy": {
                      "type": "string",
                      "enum": [
                        "rel_next",
                        "custom_selector",
                        "url_template",
                        "offset",
                        "json_cursor"
                      ]
                    },
                    "max_pages": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "selector": {
                      "type": "string"
                    },
                    "param": {
                      "type": "string"
                    },
                    "start_page": {
                      "type": "integer"
                    },
                    "step": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "start_offset": {
                      "type": "integer"
                    },
                    "increment": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "cursor_path": {
                      "type": "string"
                    },
                    "next_url_path": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              ]
            }
          },
          "required": [
            "selector"
          ],
          "description": "Defines the items selector and optional enhancement settings."
        },
        "enclosure": {
          "$schema": "http://json-schema.org/draft-06/schema#",
          "type": "object",
          "properties": {
            "extractor": {
              "description": "Extractor used to pull a value from the selected element.",
              "oneOf": [
                {
                  "$ref": "#/$defs/extractors/attribute"
                },
                {
                  "$ref": "#/$defs/extractors/href"
                },
                {
                  "$ref": "#/$defs/extractors/html"
                },
                {
                  "$ref": "#/$defs/extractors/static"
                },
                {
                  "$ref": "#/$defs/extractors/text"
                }
              ]
            },
            "attribute": {
              "type": "string",
              "minLength": 1
            },
            "static": {
              "type": "string",
              "minLength": 1
            },
            "post_process": {
              "type": "array",
              "description": "Ordered transforms applied to the extracted value.",
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/post_processors/gsub"
                  },
                  {
                    "$ref": "#/$defs/post_processors/html_to_markdown"
                  },
                  {
                    "$ref": "#/$defs/post_processors/markdown_to_html"
                  },
                  {
                    "$ref": "#/$defs/post_processors/parse_time"
                  },
                  {
                    "$ref": "#/$defs/post_processors/parse_uri"
                  },
                  {
                    "$ref": "#/$defs/post_processors/sanitize_html"
                  },
                  {
                    "$ref": "#/$defs/post_processors/substring"
                  },
                  {
                    "$ref": "#/$defs/post_processors/template"
                  }
                ]
              }
            },
            "content_type": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "description": "Describes enclosure extraction settings."
        },
        "guid": {
          "type": "array",
          "description": "List of selector keys used to build the GUID. Each entry must reference a sibling selector key; runtime validation enforces those references.",
          "minItems": 1,
          "items": {
            "type": "string",
            "description": "Selector key defined elsewhere in this object."
          }
        },
        "categories": {
          "type": "array",
          "description": "List of selector keys whose values will be used as categories. Each entry must reference a sibling selector key; runtime validation enforces those references.",
          "minItems": 1,
          "items": {
            "type": "string",
            "description": "Selector key defined elsewhere in this object."
          }
        }
      },
      "patternProperties": {
        "^(?!items$|enclosure$|guid$|categories$).+$": {
          "$schema": "http://json-schema.org/draft-06/schema#",
          "type": "object",
          "properties": {
            "extractor": {
              "description": "Extractor used to pull a value from the selected element.",
              "oneOf": [
                {
                  "$ref": "#/$defs/extractors/attribute"
                },
                {
                  "$ref": "#/$defs/extractors/href"
                },
                {
                  "$ref": "#/$defs/extractors/html"
                },
                {
                  "$ref": "#/$defs/extractors/static"
                },
                {
                  "$ref": "#/$defs/extractors/text"
                }
              ]
            },
            "attribute": {
              "type": "string",
              "minLength": 1
            },
            "static": {
              "type": "string",
              "minLength": 1
            },
            "post_process": {
              "type": "array",
              "description": "Ordered transforms applied to the extracted value.",
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/post_processors/gsub"
                  },
                  {
                    "$ref": "#/$defs/post_processors/html_to_markdown"
                  },
                  {
                    "$ref": "#/$defs/post_processors/markdown_to_html"
                  },
                  {
                    "$ref": "#/$defs/post_processors/parse_time"
                  },
                  {
                    "$ref": "#/$defs/post_processors/parse_uri"
                  },
                  {
                    "$ref": "#/$defs/post_processors/sanitize_html"
                  },
                  {
                    "$ref": "#/$defs/post_processors/substring"
                  },
                  {
                    "$ref": "#/$defs/post_processors/template"
                  }
                ]
              }
            }
          },
          "required": [],
          "description": "Dynamic selector definition keyed by attribute name."
        }
      },
      "additionalProperties": true
    },
    "request": {
      "type": "object",
      "properties": {
        "max_redirects": {
          "type": "integer",
          "not": {
            "type": "null"
          },
          "minimum": 0
        },
        "max_requests": {
          "type": "integer",
          "not": {
            "type": "null"
          },
          "exclusiveMinimum": 0
        },
        "total_timeout_seconds": {
          "type": "integer",
          "not": {
            "type": "null"
          },
          "exclusiveMinimum": 0
        },
        "botasaurus": {
          "type": "object",
          "properties": {
            "execution_mode": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "auto",
                "request",
                "browser"
              ]
            },
            "navigation_mode": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "auto",
                "get",
                "google_get",
                "google_get_bypass",
                "organic_get"
              ]
            },
            "max_retries": {
              "type": "integer",
              "not": {
                "type": "null"
              },
              "minimum": 0,
              "maximum": 3
            },
            "wait_for_selector": {
              "type": [
                "null",
                "string"
              ]
            },
            "wait_timeout_seconds": {
              "type": "integer",
              "not": {
                "type": "null"
              },
              "minimum": 1,
              "maximum": 30
            },
            "scroll": {
              "type": "boolean",
              "not": {
                "type": "null"
              }
            },
            "block_images": {
              "type": "boolean",
              "not": {
                "type": "null"
              }
            },
            "block_images_and_css": {
              "type": "boolean",
              "not": {
                "type": "null"
              }
            },
            "block_trackers": {
              "type": "boolean",
              "not": {
                "type": "null"
              }
            },
            "wait_for_complete_page_load": {
              "type": "boolean",
              "not": {
                "type": "null"
              }
            },
            "headless": {
              "type": "boolean",
              "not": {
                "type": "null"
              }
            },
            "proxy": {
              "type": "string",
              "minLength": 1
            },
            "user_agent": {
              "type": "string",
              "minLength": 1
            },
            "window_size": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "integer",
                  "not": {
                    "type": "null"
                  },
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "integer",
                  "not": {
                    "type": "null"
                  },
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "width",
                "height"
              ],
              "additionalProperties": false
            },
            "lang": {
              "type": "string",
              "minLength": 1
            },
            "cookies": {
              "type": "object"
            },
            "headers": {
              "type": "object"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "local_file_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": []
    }
  },
  "required": [
    "channel"
  ],
  "anyOf": [
    {
      "required": [
        "selectors"
      ]
    },
    {
      "required": [
        "auto_source"
      ]
    }
  ],
  "$defs": {
    "post_processors": {
      "gsub": {
        "type": "object",
        "title": "gsub",
        "description": "Replace matches of `pattern` in the extracted string with `replacement` (Ruby String#gsub; pattern may be a regexp-like string).",
        "examples": [
          {
            "name": "gsub",
            "pattern": "boo",
            "replacement": "baz"
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "const": "gsub"
          },
          "pattern": {
            "type": "string"
          },
          "replacement": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "pattern",
          "replacement"
        ],
        "additionalProperties": true
      },
      "html_to_markdown": {
        "type": "object",
        "title": "html_to_markdown",
        "description": "Sanitize HTML then convert it to Markdown (via ReverseMarkdown).",
        "examples": [
          {
            "name": "html_to_markdown"
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "const": "html_to_markdown"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": true
      },
      "markdown_to_html": {
        "type": "object",
        "title": "markdown_to_html",
        "description": "Convert Markdown to HTML (Kramdown) and sanitize the result. Often chained after `template`.",
        "examples": [
          {
            "name": "markdown_to_html"
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "const": "markdown_to_html"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": true
      },
      "parse_time": {
        "type": "object",
        "title": "parse_time",
        "description": "Parse a time string with Time.parse and return RFC822, using the channel `time_zone`.",
        "examples": [
          {
            "name": "parse_time"
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "const": "parse_time"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": true
      },
      "parse_uri": {
        "type": "object",
        "title": "parse_uri",
        "description": "Normalize a URL string; resolve relative URLs against the channel URL.",
        "examples": [
          {
            "name": "parse_uri"
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "const": "parse_uri"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": true
      },
      "sanitize_html": {
        "type": "object",
        "title": "sanitize_html",
        "description": "Sanitize HTML (sanitize gem RELAXED plus html2rss defaults: absolute URLs, safe link/img attributes, wrap lone images in anchors).",
        "examples": [
          {
            "name": "sanitize_html"
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "const": "sanitize_html"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": true
      },
      "substring": {
        "type": "object",
        "title": "substring",
        "description": "Return a slice of the extracted string using Integer `start` and optional `end` (Ruby String#[] range semantics; end may be omitted).",
        "examples": [
          {
            "name": "substring",
            "start": 4,
            "end": 6
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "const": "substring"
          },
          "start": {
            "type": "integer"
          },
          "end": {
            "type": "integer"
          }
        },
        "required": [
          "name",
          "start"
        ],
        "additionalProperties": true
      },
      "template": {
        "type": "object",
        "title": "template",
        "description": "Format a string with Kernel#format-style placeholders (`%{key}` / `%<key>s`). `%{self}` is the current selector value; other keys resolve sibling selectors.",
        "examples": [
          {
            "name": "template",
            "string": "`%{self}` (`%{price}`)"
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "const": "template"
          },
          "string": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "string"
        ],
        "additionalProperties": true
      }
    },
    "extractors": {
      "attribute": {
        "type": "string",
        "const": "attribute",
        "title": "attribute",
        "description": "Return the value of an HTML attribute on the selected element. Requires sibling selector option `attribute` (attribute name).",
        "examples": [
          "attribute"
        ]
      },
      "href": {
        "type": "string",
        "const": "href",
        "title": "href",
        "description": "Return the absolute URL from the selected element's `href` attribute (relative hrefs are resolved against the channel URL).",
        "examples": [
          "href"
        ]
      },
      "html": {
        "type": "string",
        "const": "html",
        "title": "html",
        "description": "Return the outer HTML of the selected element. Sanitize during post-processing (e.g. `sanitize_html`).",
        "examples": [
          "html"
        ]
      },
      "static": {
        "type": "string",
        "const": "static",
        "title": "static",
        "description": "Return a fixed value from sibling selector option `static` (no DOM read).",
        "examples": [
          "static"
        ]
      },
      "text": {
        "type": "string",
        "const": "text",
        "title": "text",
        "description": "Return collapsed visible text of the selected element (default extractor).",
        "examples": [
          "text"
        ]
      }
    }
  }
}
