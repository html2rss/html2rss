#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "usage: $0 <git-pathspec>..." >&2
  exit 1
fi

# Emit only paths that still exist on disk. Deleted files appear in
# `git diff --name-only` and would break RuboCop / RSpec when xargs'd.
{
  git diff --name-only --cached -z -- "$@"
  git diff --name-only -z -- "$@"
  git ls-files -o --exclude-standard -z -- "$@"
} | while IFS= read -r -d '' path; do
  if [ -f "$path" ]; then printf '%s\0' "$path"; fi
done
