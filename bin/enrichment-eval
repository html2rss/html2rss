#!/usr/bin/env ruby
# frozen_string_literal: true

# Local, non-CI eval: how much article-page metadata can html2rss already recover from JSON-LD
# and meta tags, scored against newspaper4k's saved fixture pages. Fixtures are third-party
# publisher copies and stay outside the repo. No network.
#
# FIXTURES holds html/<name>.html paired with metadata/<name>.json (url, title, authors,
# publish_date, top_image, meta_description). newspaper4k's values are its own snapshot output
# and contain bugs, so the report measures "agreement" with it, never accuracy. Per field it shows
# found-by-html2rss %, the source that supplied the value (jsonld / meta) and agreement %, then
# lists every disagreement per page. JSON-LD values come from the Thing-type objects of the page
# through Schema::Thing (first object that has the field; description is the longest of
# description/articleBody/abstract); meta tags fill the gaps. Agreement rules: dates by day, only
# when both sides parse (else n/a); authors by "any-overlap" of case-insensitive names (meta
# article:author URLs are skipped); images by host + path (meta URLs made absolute against the
# page url); title and description by whitespace-normalized, entity-decoded, case-folded equality.
#
# Usage: NEWSPAPER4K_FIXTURES=DIR mise exec -- bin/enrichment-eval
#
# Live mode (network): what would fetching each item's own article page add over the listing page?
#   BUILD_FRESH_URLS=FILE CONFIGS_DIR=DIR  writes the 50-site sample (spec/fixtures/enrichment/fresh_urls.txt)
#   FRESH_URLS=FILE CONFIGS_DIR=DIR        rebuilds each listing, matches the item by url (else drifted), fetches
#                                          the article once, prints the table and the GO/NO-GO line (T3)
# Sample rule: html2rss-configs *.yml sorted by path, configs without a published_at selector first; skip
# botasaurus and placeholder configs; first config per site whose feed builds with the default strategy; its
# first item that has a url. Fetches go through RequestService (NetworkGuard, budget), one per site, at most
# one per second, 10 s total timeout each; a timeout is a failed fetch, 403/429/challenge is blocked.

ENV['LOG_LEVEL'] ||= 'error'

require 'bundler/setup'
require 'cgi'
require 'date'
require 'json'
require 'yaml'
require_relative '../lib/html2rss'

Schema = Html2rss::AutoSource::Scraper::Schema
FETCH_TIMEOUT = 10
FETCH_INTERVAL = 1.0
SAMPLE_SIZE = 50
FIELDS = %i[title description author image published_at].freeze
# html2rss field => [newspaper4k key, og/article/name meta selectors]
META = {
  title: ['title', ['og:title']],
  description: ['meta_description', %w[og:description description]],
  author: ['authors', %w[article:author author]],
  image: ['top_image', ['og:image']],
  published_at: ['publish_date', %w[article:published_time]]
}.freeze

def usage_error(message)
  $stderr.write "#{message}\n", 'Usage: NEWSPAPER4K_FIXTURES=DIR mise exec -- bin/enrichment-eval', "\n"
  exit 1
end

def text(value) = CGI.unescapeHTML(value.to_s).gsub(/[[:space:]]+/, ' ').strip.downcase

def day(value) = (Date.parse(value.to_s) rescue nil)&.iso8601 # rubocop:disable Style/RescueModifier

def names(value) = Array(value).flat_map { _1.to_s.split(/,|&|\band\b/i) }.map { text(_1) }.reject(&:empty?).to_set

def image_key(value)
  uri = URI.parse(value.to_s.strip)
  "#{uri.host&.downcase}#{uri.path.to_s.chomp('/')}"
rescue URI::InvalidURIError
  text(value)
end

def agree?(field, ours, theirs)
  case field
  when :published_at then (ours_day = day(ours)) && (theirs_day = day(theirs)) ? ours_day == theirs_day : nil
  when :author then names(ours).intersect?(names(theirs))
  when :image then image_key(ours) == image_key(theirs)
  else text(ours) == text(theirs)
  end
end

def jsonld_things(doc, url)
  doc.css('script[type="application/ld+json"]').flat_map do |script|
    Schema.from_script(script).select { Schema.scraper_for_schema_object(_1) == Schema::Thing }
          .map { Schema::Thing.new(_1, url:) }
  rescue JSON::ParserError
    []
  end
end

def jsonld_value(things, field)
  things.each do |thing|
    # Thing#author falls back to publisher; only the object's own author counts here.
    next if field == :author && !thing.schema_object[:author]

    value = thing.public_send(field).to_s.strip
    return value unless value.empty?
  end
  nil
end

def meta_value(doc, field, url)
  META.fetch(field).last.each do |key|
    value = doc.at_css("meta[property='#{key}'], meta[name='#{key}']")&.[]('content').to_s.strip
    next if value.empty? || (field == :author && value.include?('://'))

    return field == :image ? absolute(value, url) : value
  end
  nil
end

def absolute(value, base)
  Html2rss::Url.from_relative(value, base).to_s
rescue StandardError
  value
end

def extract(doc, url)
  things = jsonld_things(doc, url)
  FIELDS.to_h do |field|
    if (value = jsonld_value(things, field)) then [field, [value, :jsonld]]
    elsif (value = meta_value(doc, field, url)) then [field, [value, :meta]]
    else [field, [nil, :none]]
    end
  end
end

def evaluate(dir)
  Dir[File.join(dir, 'metadata', '*.json')].filter_map do |meta_path|
    name = File.basename(meta_path, '.json')
    html = File.join(dir, 'html', "#{name}.html")
    next unless File.exist?(html)

    expected = JSON.parse(File.read(meta_path))
    found = extract(Nokogiri::HTML(File.read(html)), expected['url'])
    { name:, expected:, found: }
  end
end

def blank?(value) = Array(value).all? { _1.to_s.strip.empty? }

def percent(part, whole) = whole.zero? ? '-' : format('%.0f%%', 100.0 * part / whole)

def verdict_for(agreed) = { true => :agree, false => :disagree, nil => :n_a }.fetch(agreed)

# Compared cells for one page: [field, source, ours, theirs, verdict] (verdict :agree, :disagree, :n_a).
def cells(page)
  FIELDS.map do |field|
    ours, source = page[:found].fetch(field)
    theirs = page[:expected][META.fetch(field).first]
    verdict = ours.nil? || blank?(theirs) ? :n_a : verdict_for(agree?(field, ours, theirs))
    [field, source, ours, theirs, verdict]
  end
end

def table_row(field, mine) # rubocop:disable Metrics/AbcSize -- one tally per report column
  found = mine.reject { _1[1] == :none }
  compared = mine.reject { _1[4] == :n_a }
  agreed = compared.count { _1[4] == :agree }
  [field, percent(found.size, mine.size), found.count { _1[1] == :jsonld }, found.count { _1[1] == :meta },
   "#{percent(agreed, compared.size)} (#{compared.size} compared)"]
end

def table(pages)
  all = pages.flat_map { cells(_1) }
  rows = FIELDS.map { |field| table_row(field, all.select { _1.first == field }) }
  [%w[field found jsonld meta agreement], *rows].map { |row| row.map { _1.to_s.ljust(14) }.join.rstrip }
end

def disagreements(pages)
  pages.flat_map do |page|
    cells(page).select { _1[4] == :disagree }.map do |field, source, ours, theirs, _|
      "#{page[:name]} #{field} [#{source}] html2rss=#{ours.inspect} newspaper4k=#{theirs.inspect}"
    end
  end
end

# --- live mode: article page vs listing page -------------------------------------------------------------

# Listing-only values of a feed item (JSON Feed hash), keyed by eval field.
def listing_fields(item)
  {
    title: item[:title], description: item[:content_text] || item[:content_html],
    author: Array(item[:authors]).filter_map { _1[:name] }.first, image: item[:image],
    published_at: item[:date_published]
  }
end

def feed_items(config_path)
  Html2rss.json_feed(YAML.safe_load_file(config_path, symbolize_names: true))[:items] || []
end

def candidate_configs(dir)
  Dir.glob('**/*.yml', base: dir).sort.filter_map do |rel|
    body = File.read(File.join(dir, rel))
    [body.include?('published_at') ? 1 : 0, rel] unless body.match?(/botasaurus|%[<{]/)
  end.sort.map(&:last)
end

def sample_url(dir, rel)
  feed_items(File.join(dir, rel)).find { _1[:url].to_s.start_with?('http') }&.fetch(:url)
rescue StandardError => error
  warn "skip #{rel}: #{error.class}"
end

def build_sample(dir)
  candidate_configs(dir).each_with_object({}) do |rel, rows|
    break rows if rows.size >= SAMPLE_SIZE

    site = rel.split('/').first
    next if rows.key?(site)

    (url = sample_url(dir, rel)) && rows[site] = [rel, url]
  end.values
end

SAMPLE_HEADER = <<~TEXT
  # Fresh-URL sample for FRESH_URLS bin/enrichment-eval, built %<date>s.
  # Rule: html2rss-configs *.yml sorted by path, configs without a published_at selector first;
  # skipping botasaurus and %%<param> configs; one config per site, the first whose feed builds with
  # the default strategy; its first item with a url. Columns: config path <TAB> article URL.
TEXT

def write_sample(file, dir)
  rows = build_sample(dir)
  File.write(file, format(SAMPLE_HEADER, date: Date.today.iso8601) + rows.map { "#{_1.join("\t")}\n" }.join)
  puts "Wrote #{rows.size} rows to #{file}"
end

def read_sample(file)
  File.readlines(file, chomp: true).reject { _1.empty? || _1.start_with?('#') }.map { _1.split("\t", 2) }
end

def request_context(url)
  Html2rss::RequestService::Context.new(
    url:, budget: Html2rss::RequestService::Budget.new(max_requests: 1, total_timeout_seconds: FETCH_TIMEOUT),
    policy: Html2rss::RequestService::Policy.new(total_timeout_seconds: FETCH_TIMEOUT,
                                                 read_timeout_seconds: FETCH_TIMEOUT)
  )
end

def fetch_kind(status) = { 403 => :blocked, 429 => :blocked }.fetch(status, status.to_i >= 400 ? :failed : :ok)

def now = Process.clock_gettime(Process::CLOCK_MONOTONIC)

def fetch_outcome(url)
  response = Html2rss::RequestService.execute(request_context(url), strategy: :default)
  { kind: fetch_kind(response.status), status: response.status, host: response.url.host, doc: response.parsed_body }
rescue Html2rss::RequestService::BlockedSurfaceDetected
  { kind: :blocked }
rescue StandardError => error
  { kind: :failed, error: error.class.name.split('::').last }
end

# One live fetch: kind is :ok, :blocked (403/429/challenge) or :failed (errors and timeouts), plus wall seconds.
def fetch_page(url)
  started = now
  fetch_outcome(url).merge(seconds: now - started)
end

def fresh_row(rel, url, dir)
  item = feed_items(File.join(dir, rel)).find { _1[:url] == url }
  return { rel:, url:, kind: :drifted } unless item

  page = fetch_page(url)
  warn "#{rel} #{page[:kind]} #{page[:status]} #{page[:error]}"
  { rel:, url:, listing: listing_fields(item), article: page[:doc] && extract(page[:doc], url), **page.except(:doc) }
rescue StandardError => error
  warn "#{rel} drifted (#{error.class})"
  { rel:, url:, kind: :drifted }
end

def fresh_rows(file, dir)
  last = nil
  read_sample(file).map do |rel, url|
    sleep(FETCH_INTERVAL - (now - last)) if last && now - last < FETCH_INTERVAL
    last = now
    fresh_row(rel, url, dir)
  end
end

def pct(part, whole) = whole.zero? ? 0.0 : 100.0 * part / whole

def percentile(values, quantile)
  sorted = values.sort
  sorted.empty? ? 0.0 : sorted[((sorted.size - 1) * quantile).ceil]
end

def listing_found(rows, field) = pct(rows.count { !blank?(_1[:listing][field]) }, rows.size)

def fresh_lift(rows, field) # rubocop:disable Metrics/AbcSize -- one tally per report column
  listing = listing_found(rows, field)
  union = pct(rows.count { !blank?(_1[:listing][field]) || _1[:article][field].first }, rows.size)
  sources = rows.map { |row| row[:article][field] }.reject { |value, _| value.nil? }.map(&:last)
  { listing:, union:, lift: union - listing, jsonld: sources.count(:jsonld), meta: sources.count(:meta) }
end

def fresh_line(field, lift, all_listing)
  cells = [field, "#{lift[:listing].round}%", "#{lift[:union].round}%", format('%+d', lift[:lift].round),
           "#{lift[:jsonld]} / #{lift[:meta]}", "#{all_listing.round}%"]
  "| #{cells.join(' | ')} |"
end

def verdict(lifts, ok_count, median)
  lift = %i[published_at image].map { lifts.fetch(_1)[:lift] }.max
  reasons = []
  reasons << format('published_at/image lift %.0f < 15 points', lift) if lift < 15
  reasons << "successful fetches #{ok_count} < 40" if ok_count < 40
  reasons << format('median fetch %.2f s > 1.5 s', median) if median > 1.5
  reasons.empty? ? 'GO for T3' : "NO-GO for T3: #{reasons.join('; ')}"
end

def fresh_summary(rows, rebuilt, fetched) # rubocop:disable Metrics/AbcSize -- one report header
  count = ->(kind) { rebuilt.count { _1[:kind] == kind } }
  secs = fetched.map { _1[:seconds] }
  ["Sample: #{rows.size} urls; fetched ok #{fetched.size}, blocked #{count[:blocked]}, failed #{count[:failed]}, " \
   "drifted #{rows.size - rebuilt.size} (excluded)",
   "Fetch wall time over ok fetches: median #{format('%.2f', percentile(secs, 0.5))} s, " \
   "p90 #{format('%.2f', percentile(secs, 0.9))} s",
   "Lift columns use the #{fetched.size} ok fetches; last column is listing-only over all #{rebuilt.size} rebuilt.", '']
end

def fresh_report(rows) # rubocop:disable Metrics/AbcSize -- one report
  rebuilt = rows.reject { _1[:kind] == :drifted }
  ok = rebuilt.select { _1[:kind] == :ok }
  lifts = FIELDS.to_h { [_1, fresh_lift(ok, _1)] }
  puts fresh_summary(rows, rebuilt, ok),
       '| field | listing | +article | lift pts | jsonld / meta | listing-only (all) |', '|---|---|---|---|---|---|',
       *FIELDS.map { fresh_line(_1, lifts.fetch(_1), listing_found(rebuilt, _1)) }, '',
       verdict(lifts, ok.size, percentile(ok.map { _1[:seconds] }, 0.5))
end

def configs_dir
  dir = ENV.fetch('CONFIGS_DIR', '').strip
  usage_error('CONFIGS_DIR (html2rss-configs lib/html2rss/configs) is not a directory.') unless File.directory?(dir)
  dir
end

if (sample_file = ENV.fetch('BUILD_FRESH_URLS', '').strip) != ''
  write_sample(sample_file, configs_dir)
  exit
elsif (fresh_file = ENV.fetch('FRESH_URLS', '').strip) != ''
  usage_error("FRESH_URLS is not a file: #{fresh_file}") unless File.file?(fresh_file)
  fresh_report(fresh_rows(fresh_file, configs_dir))
  exit
end

dir = ENV.fetch('NEWSPAPER4K_FIXTURES', '').strip
usage_error('NEWSPAPER4K_FIXTURES is not set.') if dir.empty?
usage_error("NEWSPAPER4K_FIXTURES is not a directory: #{dir}") unless File.directory?(dir)

pages = evaluate(dir)
usage_error("No html/<name>.html + metadata/<name>.json pairs in #{dir}") if pages.empty?

puts "Pages: #{pages.size} (agreement with newspaper4k's snapshot output, not accuracy)", '', table(pages), ''
puts 'Disagreements', *disagreements(pages)
