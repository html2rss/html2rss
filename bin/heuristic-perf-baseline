#!/usr/bin/env ruby
# frozen_string_literal: true

# Captures wall time + allocation baseline for auto-source paths.
# Usage:
#   mise exec -- bin/heuristic-perf-baseline [--write PATH] [--backend nokogiri|nokolexbor|rust|all]

require 'bundler/setup'
require 'fileutils'
require 'optparse'
require_relative '../lib/html2rss'

FIXTURES = [
  'spec/fixtures/page_1.html',
  'spec/fixtures/multi_link_block.html',
  'spec/fixtures/local_feed_test.html'
].freeze

WARMUP = 1
RUNS = 5
BASE_URL = 'https://example.com/'
BACKENDS = %w[nokogiri nokolexbor rust].freeze

def run_heuristics(parsed_body) # rubocop:disable Metrics/MethodLength
  semantic = Html2rss::AutoSource::Scraper::SemanticHtml.new(
    parsed_body, url: BASE_URL, fallback_anchorless: true
  )
  html = Html2rss::AutoSource::Scraper::Html.new(
    parsed_body,
    url: BASE_URL,
    fallback_anchorless: true,
    minimum_selector_frequency: 2,
    use_top_selectors: 5
  )
  [semantic.to_a.size, html.to_a.size]
end

def run_auto_source(parsed_body, body)
  url = Html2rss::Url.from_absolute(BASE_URL)
  response = Html2rss::RequestService::Response.new(
    body:,
    headers: { 'content-type' => 'text/html' },
    url:
  )
  response.instance_variable_set(:@parsed_body, parsed_body)
  Html2rss::AutoSource.new(response).articles.size
end

def measure(parsed_bodies, bodies)
  GC.start
  before_alloc = GC.stat[:total_allocated_objects]
  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  heuristic_counts = parsed_bodies.map { run_heuristics(_1) }
  auto_counts = parsed_bodies.zip(bodies).map { |doc, body| run_auto_source(doc, body) }
  wall = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
  allocs = GC.stat[:total_allocated_objects] - before_alloc
  [wall, allocs, heuristic_counts, auto_counts]
end

def parse_bodies(bodies, backend_name)
  Html2rss::Html::Backend.use(backend_name)
  bodies.map { Html2rss::Html::Document.parse(_1) }
end

def median(arr) = arr.sort[arr.size / 2]

def benchmark_backend(backend_name, bodies) # rubocop:disable Metrics/MethodLength
  parsed_bodies = parse_bodies(bodies, backend_name)
  WARMUP.times { measure(parsed_bodies, bodies) }

  walls = []
  allocs = []
  heuristic_counts = nil
  auto_counts = nil
  RUNS.times do
    wall, alloc, h_counts, a_counts = measure(parsed_bodies, bodies)
    walls << wall
    allocs << alloc
    heuristic_counts = h_counts
    auto_counts = a_counts
  end

  {
    backend: backend_name,
    wall_med: median(walls),
    alloc_med: median(allocs),
    heuristic_counts:,
    auto_counts:
  }
end

def format_result(result) # rubocop:disable Metrics/MethodLength
  lines = []
  lines << "## Backend: #{result[:backend]}"
  lines << ''
  lines << '| Metric | Value |'
  lines << '| --- | --- |'
  lines << "| wall_time_s (median) | #{format('%.6f', result[:wall_med])} |"
  lines << "| allocations (median) | #{result[:alloc_med]} |"
  lines << "| wall_budget_1_1x | #{format('%.6f', result[:wall_med] * 1.1)} |"
  lines << "| alloc_budget_1_15x | #{(result[:alloc_med] * 1.15).ceil} |"
  lines << ''
  lines << 'Article counts per fixture (semantic, html | AutoSource#articles):'
  FIXTURES.each_with_index do |fixture, idx|
    semantic_n, html_n = result[:heuristic_counts][idx]
    lines << "- #{fixture}: semantic=#{semantic_n}, html=#{html_n}, auto_source=#{result[:auto_counts][idx]}"
  end
  lines << ''
  lines
end

options = { write: nil, backend: 'all' }
OptionParser.new do |opts|
  opts.on('--write PATH', 'Write markdown baseline to PATH') { |path| options[:write] = path }
  opts.on('--backend NAME', 'nokogiri, nokolexbor, rust, or all (default: all)') { |name| options[:backend] = name }
end.parse!

backends = case options[:backend]
           when 'all', 'both' then BACKENDS
           when *BACKENDS then [options[:backend]]
           else
             raise ArgumentError, "Unknown --backend #{options[:backend].inspect}"
           end

root = File.expand_path('..', __dir__)
bodies = FIXTURES.map { |rel| File.read(File.join(root, rel)) }

results = backends.map do |backend_name|
  benchmark_backend(backend_name, bodies)
rescue LoadError => error
  warn "Skipping #{backend_name}: #{error.message}"
  nil
end.compact

Html2rss::Html::Backend.reset!

lines = []
lines << '# Auto-source performance baseline'
lines << ''
lines << "Captured: #{Time.now.utc.iso8601}"
lines << "Ruby: #{RUBY_VERSION}"
lines << "Fixtures: #{FIXTURES.join(', ')}"
lines << "Warmup runs: #{WARMUP}; measured runs: #{RUNS} (median reported)"
lines << "Backends: #{results.map { _1[:backend] }.join(', ')}"
lines << ''

if results.size >= 2
  nokogiri = results.find { _1[:backend] == 'nokogiri' }
  lines << '## Comparison (vs nokogiri)'
  lines << ''
  lines << '| Backend | wall_time_s | allocations | wall Δ% | alloc Δ% |'
  lines << '| --- | --- | --- | --- | --- |'
  results.each do |result|
    if result[:backend] == 'nokogiri' || nokogiri.nil?
      lines << "| #{result[:backend]} | #{format('%.6f', result[:wall_med])} | #{result[:alloc_med]} | — | — |"
    else
      wall_delta = ((result[:wall_med] / nokogiri[:wall_med]) - 1) * 100
      alloc_delta = ((result[:alloc_med].to_f / nokogiri[:alloc_med]) - 1) * 100
      lines << "| #{result[:backend]} | #{format('%.6f', result[:wall_med])} | #{result[:alloc_med]} | " \
               "#{format('%+.1f', wall_delta)} | #{format('%+.1f', alloc_delta)} |"
    end
  end
  lines << ''
end

results.each { |result| lines.concat(format_result(result)) }

report = lines.join("\n")
puts report

if options[:write]
  path = File.expand_path(options[:write], root)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, report)
  warn "Wrote #{path}"
end
