#!/usr/bin/env ruby
# frozen_string_literal: true

# Captures wall time + allocation baseline for auto-source paths.
# Budget rule: bin/lib/perf_baseline.rb.
# Usage: mise exec -- bin/heuristic-perf-baseline [--write PATH] [--check PATH]

require 'bundler/setup'
require 'nokogiri'
require_relative '../lib/html2rss'
require_relative 'lib/perf_baseline'

FIXTURES = [
  'spec/fixtures/news_front_page.html',
  'spec/fixtures/multi_link_block.html',
  'spec/fixtures/local_feed_test.html',
  'spec/fixtures/auto_source/corpus/menu_mixed_top_level.html',
  'spec/fixtures/auto_source/corpus/schema_footer_extras.html',
  'spec/fixtures/auto_source/corpus/structured_small_merge.html'
].freeze

BASE_URL = 'https://example.com/'

def run_heuristics(parsed_body)
  semantic = Html2rss::AutoSource::Scraper::SemanticHtml.new(parsed_body, url: BASE_URL)
  html = Html2rss::AutoSource::Scraper::Html.new(
    parsed_body,
    url: BASE_URL,
    minimum_selector_frequency: 2,
    use_top_selectors: 5
  )
  [semantic.to_a.size, html.to_a.size]
end

def run_auto_source(parsed_body, body)
  url = Html2rss::Url.from_absolute(BASE_URL)
  response = Html2rss::RequestService::Response.new(
    body:,
    headers: { 'content-type' => 'text/html' },
    url:
  )
  response.instance_variable_set(:@parsed_body, parsed_body)
  Html2rss::AutoSource.new(response).articles.size
end

root = File.expand_path('..', __dir__)
bodies = FIXTURES.map { |rel| File.read(File.join(root, rel)) }
parsed_bodies = bodies.map { Nokogiri::HTML(_1) }

PerfBaseline.run(
  title: 'Auto-source performance baseline',
  subject: "Fixtures: #{FIXTURES.join(', ')}",
  summary: 'Article counts per fixture (semantic, html | AutoSource#articles)',
  root:
) do
  heuristic_counts = parsed_bodies.map { run_heuristics(_1) }
  auto_counts = parsed_bodies.zip(bodies).map { |doc, body| run_auto_source(doc, body) }
  FIXTURES.zip(heuristic_counts, auto_counts).to_h do |fixture, (semantic, html), auto|
    [fixture, "semantic=#{semantic}, html=#{html}, auto_source=#{auto}"]
  end
end
